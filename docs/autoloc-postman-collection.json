            },
            "url": {
              "raw": "{{baseUrl}}/api/paiements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "paiements"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Statut 405 Method Not Allowed\", () => { pm.response.to.have.status(405); });"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
